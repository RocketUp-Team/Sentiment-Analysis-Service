
    digraph G {
    rankdir=TB;

graph [fontname="Helvetica", bgcolor="white", pad="0.3", nodesep="0.5", ranksep="0.7"]
node [shape=box, style="rounded,filled", fontname="Helvetica", fillcolor="#EFF6FF", color="#1D4ED8", penwidth=1.3]
edge [fontname="Helvetica", color="#1F2937", arrowsize=0.8]

    input [label="Input text"];
    tok [label="Tokenizer"];
    backbone [label="Transformer backbone
RoBERTa / XLM-RoBERTa"];
    head [label="Sequence classification head"];
    sentiment [label="Overall sentiment"];
    sarcasm [label="Sarcasm adapter"];
    absa [label="Zero-shot ABSA
DeBERTa v3"];
    shap [label="SHAP explanations"];
    input -> tok -> backbone -> head;
    head -> sentiment;
    backbone -> sarcasm;
    sentiment -> absa;
    sentiment -> shap;
    }
