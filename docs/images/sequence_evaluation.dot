digraph G {
rankdir=LR;

    graph [rankdir=LR, fontname="Helvetica", bgcolor="white", pad="0.25", nodesep="0.45", ranksep="0.55"]
    node [shape=box, style="rounded,filled", fontname="Helvetica", fillcolor="#F8FAFC", color="#64748B", penwidth=1.1]
    edge [fontname="Helvetica", color="#1F2937", arrowsize=0.8]

user [label="User"]
front [label="Frontend"]
api [label="FastAPI"]
model [label="Model"]

dev -> api [label="POST /evaluate"];
api -> model [label="evaluate_on_dataset"];
model -> api [label="metrics payload"];
api -> dev [label="baseline_metrics / fairness"];
}